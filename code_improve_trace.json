  "outputs": {
    "code": "```javascript\nfunction chunk(arr, size) {\n    if (typeof size !== 'number' || size < 1 || !Number.isInteger(size)) {\n        throw new Error('invalid size');\n    }\n    if (arr.length === 0) {\n        return [];\n    }\n    \n    const result = [];\n    for (let i = 0; i < arr.length; i += size) {\n        result.push(arr.slice(i, i + size));\n    }\n    return result;\n}\n```"
  },
