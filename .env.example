# Copy to .env.local and fill in. .env.local is gitignored — never commit it.

# Plant's compiler model (gpt-4o) and the writer/judge nodes
OPENAI_API_KEY=sk-...

# GitHub access — two fine-grained PATs, deliberately split:
#   READ:  read-only, all repos you want Plant to see (its asset source)
#   WRITE: read/write, scoped to ONLY your sandbox repo below
# mcp.json routes READ to the `github` server (tools github__*) and WRITE to
# the `playground` server (tools playground__*). No quotes around values.
GITHUB_PAT_READ=github_pat_...
GITHUB_PAT_WRITE=github_pat_...

# Your sandbox repo — the demos write real commits here (and recover them).
# Create an empty repo with a README, scope GITHUB_PAT_WRITE to it alone.
PLAYGROUND_OWNER=your-github-username
PLAYGROUND_REPO=your-sandbox-repo

# Root directory the filesystem MCP server may touch. Keep it narrow —
# a large root makes filesystem__search_files time out.
FRACTAL_FS_ROOT=C:/path/to/a/workspace
