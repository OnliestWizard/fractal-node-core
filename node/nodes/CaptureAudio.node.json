{
  "id": "capture_audio",
  "description": "capture spoken input from the user",
  "inputs": [
    { "id": "duration_ms", "type": "number", "optional": true }
  ],
  "outputs": [
    { "id": "audio_blob", "type": "audio" }
  ],
  "sideEffects": ["microphone", "hardware_access"],
  "constraints": {
    "offlineCapable": true,
    "realtime": true
  }
}
